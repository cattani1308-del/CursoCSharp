[*.cs]

# IDE0005: O uso da diretiva é desnecessário.
dotnet_diagnostic.IDE0005.severity = none

# CS8618: O campo não anulável precisa conter um valor não nulo ao sair do construtor. Considere adicionar o modificador "obrigatório" ou declarar como anulável.
dotnet_diagnostic.CS8618.severity = error

# IDE0059: Atribuição desnecessária de um valor
csharp_style_unused_value_assignment_preference = unused_local_variable

# IDE0058: O valor da expressão nunca é usado
csharp_style_unused_value_expression_statement_preference = unused_local_variable

# IDE0044: Adicionar modificador somente leitura
dotnet_style_readonly_field = true

# IDE0022: Usar o corpo do bloco para método
dotnet_diagnostic.IDE0022.severity = none

# IDE0040: Adicionar modificadores de acessibilidade
dotnet_style_require_accessibility_modifiers = never

# IDE0055: Corrigir a formatação
dotnet_diagnostic.IDE0055.severity = none
